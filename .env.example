POSTGRES_DB=team_empo
POSTGRES_USER=team_empo
POSTGRES_PASSWORD=local_password
POSTGRES_PORT=5432
API_PORT=3000
FRONTEND_PORT=5173

# Optional: without an API key, recommendations are built from the selected real data source using templates.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_MS=300000
RECOMMENDATION_DATA_SOURCE=production_subset
PRODUCTION_SUBSET_DIRECTORY=database/production_subset/csv
RECOMMENDATION_CACHE_TTL_MS=900000
RECOMMENDATION_STALE_AFTER_DAYS=60
RECOMMENDATION_STORAGE_ENABLED=true

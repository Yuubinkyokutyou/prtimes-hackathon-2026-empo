# auto はDB URLがあればPostgreSQL、なければ同梱データを使います。
PR_DATA_MODE=auto
PR_EMBEDDING_PROVIDER=local
PR_GENERATION_PROVIDER=local
PR_HOST=127.0.0.1
PR_PORT=8765

# RDS/PostgreSQLを利用する場合だけ設定します。
# PR_DATABASE_URL=postgresql://hackathon:運営配布パスワード@運営配布RDSホスト:5432/prtimes

# OpenAI APIを利用する場合だけ設定します。実値はGitへ入れないでください。
# OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-4o-mini

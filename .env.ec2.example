# URL encode special characters in the user name or password.
DATABASE_URL=postgresql://app_user:change_me@your-rds-endpoint.ap-northeast-1.rds.amazonaws.com:5432/team_empo
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
CORS_ORIGIN=https://example.com
WEB_PORT=80
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_MS=300000
RECOMMENDATION_DATA_SOURCE=database
PRODUCTION_SUBSET_DIRECTORY=
RECOMMENDATION_CACHE_TTL_MS=900000
RECOMMENDATION_STALE_AFTER_DAYS=60
RECOMMENDATION_STORAGE_ENABLED=true
